# Server Configuration
PORT=3000

# Database Configuration (mysql or sqlite)
DB_TYPE=sqlite

# MySQL Settings (Only used if DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=onest_cert_db

# Moodle LMS Integration
# For testing locally, this points to our own server's mock endpoint
MOODLE_API_URL=http://localhost:3000/mock-moodle
MOODLE_TOKEN=mock_moodle_api_token_12345

# Cryptographic Issuer Settings
ISSUER_DID=did:web:onest.certplatform.com
